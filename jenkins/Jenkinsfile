pipeline {
    agent any

    environment {
        AWS_REGION      = 'ap-south-1'
        ECR_REPO        = '486336528116.dkr.ecr.ap-south-1.amazonaws.com/devops-project/spring-app'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        IS_JENKINS_COMMIT = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def message = sh(
                        script: 'git log -1 --format="%s"',
                        returnStdout: true
                    ).trim()
                    echo "Last commit message: ${message}"
                    env.IS_JENKINS_COMMIT = message.contains('[skip ci]') ? 'true' : 'false'
                    if (env.IS_JENKINS_COMMIT == 'true') {
                        echo "Jenkins commit detected — skipping pipeline"
                    }
                }
            }
        }

        stage('Build & Test') {
            when { expression { env.IS_JENKINS_COMMIT == 'false' } }
            steps {
                sh '/opt/maven/bin/mvn clean verify -f app/pom.xml'
            }
        }

        stage('Docker Build') {
            when { expression { env.IS_JENKINS_COMMIT == 'false' } }
            steps {
                sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} -f app/Dockerfile app/"
            }
        }

        stage('Trivy Scan') {
            when { expression { env.IS_JENKINS_COMMIT == 'false' } }
            steps {
                sh """
                    trivy image \
                        --exit-code 1 \
                        --severity CRITICAL \
                        --no-progress \
                        --ignore-unfixed \
                        ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Push to ECR') {
            when { expression { env.IS_JENKINS_COMMIT == 'false' } }
            steps {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS \
                            --password-stdin 486336528116.dkr.ecr.ap-south-1.amazonaws.com
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Update Helm Chart') {
            when { expression { env.IS_JENKINS_COMMIT == 'false' } }
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        sed -i "s|tag:.*|tag: \\"''' + env.IMAGE_TAG + '''\\"| " helm/spring-app/values.yaml
                        git config user.email "jenkins@devops-project.local"
                        git config user.name "Jenkins"
                        git add helm/spring-app/values.yaml
                        git commit -m "[skip ci] update image tag to ''' + env.IMAGE_TAG + '''"
                        git push https://$GITHUB_TOKEN@github.com/RevanthChalamalasetty/devops-project.git HEAD:main
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.IS_JENKINS_COMMIT == 'true') {
                    currentBuild.result = 'SUCCESS'
                    currentBuild.description = 'Skipped: Jenkins own commit'
                }
                sh "docker rmi ${ECR_REPO}:${IMAGE_TAG} || true"
            }
        }
    }
}
