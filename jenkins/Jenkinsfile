pipeline {
    agent any

    environment {
        AWS_REGION      = 'ap-south-1'
        ECR_REPO        = '486336528116.dkr.ecr.ap-south-1.amazonaws.com/devops-project/spring-app'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def lastCommitAuthor = sh(
                        script: 'git log -1 --format="%an"',
                        returnStdout: true
                    ).trim()
                    if (lastCommitAuthor == 'Jenkins') {
                        currentBuild.result = 'SUCCESS'
                        error('Skipping — triggered by Jenkins own commit')
                    }
                }
                echo "Building commit: ${env.GIT_COMMIT}"
            }
        }

        stage('Build & Test') {
            steps {
                sh '/opt/maven/bin/mvn clean verify -f app/pom.xml'
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} -f app/Dockerfile app/"
            }
        }

        stage('Trivy Scan') {
            steps {
                sh """
                    trivy image \
                        --exit-code 1 \
                        --severity CRITICAL \
                        --no-progress \
                        --ignore-unfixed \
                        ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Push to ECR') {
            steps {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS \
                            --password-stdin 486336528116.dkr.ecr.ap-south-1.amazonaws.com
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Update Helm Chart') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        sed -i "s|tag:.*|tag: \\"''' + env.IMAGE_TAG + '''\\"| " helm/spring-app/values.yaml
                        git config user.email "jenkins@devops-project.local"
                        git config user.name "Jenkins"
                        git add helm/spring-app/values.yaml
                        git commit -m "ci: update image tag to ''' + env.IMAGE_TAG + '''"
                        git push https://$GITHUB_TOKEN@github.com/RevanthChalamalasetty/devops-project.git HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed. Image: ${ECR_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline failed at stage: ${env.STAGE_NAME}"
        }
        always {
            sh "docker rmi ${ECR_REPO}:${IMAGE_TAG} || true"
        }
    }
}
